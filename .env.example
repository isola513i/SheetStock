# Google Sheets server-side integration (preferred: service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="your-spreadsheet-id"
GOOGLE_SHEETS_RANGE="สินค้า!A:P"
GOOGLE_USERS_RANGE="รหัสลูกค้า!A:E"
GOOGLE_ANNOUNCEMENTS_RANGE="ประกาศ!A:B"

# Auth token signing secret (generate with: openssl rand -base64 32)
TOKEN_SECRET="your-random-secret-here"

# Public site URL used for metadata and social previews
NEXT_PUBLIC_SITE_URL="https://sheetstock-38138187569.asia-southeast1.run.app"

# Product image uploads (required for /api/upload/image)
GCS_BUCKET_NAME="your-product-images-bucket"

# Optional fallback for public sheets:
GOOGLE_API_KEY="your-google-api-key"
